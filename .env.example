# ===========================================================================
# HIRAM — Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in your values.
# All VAULT_* secrets are auto-seeded into the encrypted vault on first boot.
# After first boot, they're encrypted in SQLite — you can remove them from .env.
# ===========================================================================

# ---------------------------------------------------------------------------
# Required — system cannot start without these
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
HIRAM_MASTER_KEY=your-strong-random-passphrase-here   # Used for AES-256 vault encryption

# ---------------------------------------------------------------------------
# System configuration (defaults shown)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
SQLITE_PATH=./data/hiram.db
SOCKET_PATH=/var/run/hiram/hiram.sock
TCP_PORT=7400
WEBHOOK_PORT=7401
WORKSPACE_ROOT=/opt/hiram
TOOLS_DIR=./tools
BACKUP_DIR=./backups
BACKUP_RETAIN=10
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Vault secrets — seeded on first boot from VAULT_* env vars
# ---------------------------------------------------------------------------
# After the first boot, secrets are encrypted in SQLite and these env vars
# can be removed. If the vault already has a secret, the env var is ignored.

# --- Infrastructure (Cloudflare) ---
VAULT_CLOUDFLARE_API_TOKEN=                   # Cloudflare API token with Zone/DNS/Workers permissions
VAULT_CLOUDFLARE_EMAIL=                       # Cloudflare account email
VAULT_CLOUDFLARE_ACCOUNT_ID=                  # Cloudflare account ID (from dashboard URL)

# --- Infrastructure (GCP / Google Workspace) ---
VAULT_GCP_CLIENT_EMAIL=                       # GCP service account email (xxx@project.iam.gserviceaccount.com)
VAULT_GCP_PROJECT_ID=                         # GCP project ID
VAULT_GCP_PRIVATE_KEY_ID=                     # GCP private key ID
VAULT_GCP_CLIENT_ID=                          # GCP client ID
VAULT_GCP_PRIVATE_KEY_B64=                    # GCP private key, base64-encoded (base64 -w0 < key.pem)

# --- Finance (Stripe) ---
VAULT_STRIPE_SECRET_KEY=sk_live_...           # Stripe secret key
VAULT_STRIPE_WEBHOOK_SECRET=whsec_...         # Stripe webhook signing secret

# --- Outreach & Sales (optional) ---
VAULT_INSTANTLY_API_KEY=                      # Instantly.ai API key (cold email)
VAULT_APOLLO_API_KEY=                         # Apollo.io API key (lead enrichment)
VAULT_HUBSPOT_PRIVATE_APP_TOKEN=              # HubSpot private app token
VAULT_HUBSPOT_DEVELOPER_API_KEY=              # HubSpot developer API key
VAULT_HUBSPOT_APP_ID=                         # HubSpot app ID (for webhook subscriptions)

# --- Atlassian (JIRA) ---
VAULT_ATLASSIAN_EMAIL=                        # Atlassian account email
VAULT_ATLASSIAN_API_TOKEN=                    # Atlassian API token (id.atlassian.com → Security → API tokens)
VAULT_ATLASSIAN_SITE_URL=https://yoursite.atlassian.net

# --- GitHub ---
VAULT_GITHUB_TOKEN=github_pat_...             # GitHub PAT with repo, workflow, org permissions

# --- Webhook relay ---
VAULT_WEBHOOK_RELAY_SECRET=                   # Shared HMAC secret between Cloud Function relay and HIRAM
                                              # Generate: openssl rand -hex 32

# --- Core system ---
VAULT_VOYAGE_API_KEY=                         # Voyage AI API key (knowledge store embeddings)
VAULT_TELEGRAM_BOT_TOKEN=                     # Telegram bot token (founder notifications)
VAULT_FOUNDER_EMAIL=you@domain.com            # Email for Google Workspace impersonation

# --- Cloudflare Tunnel ---
VAULT_CLOUDFLARE_TUNNEL_TOKEN=                # Cloudflare Tunnel token (cloudflared service token)
VAULT_HIRAM_PUBLIC_URL=https://hiram.yourdomain.com

# --- Git identity ---
VAULT_GIT_EMAIL=hiram@yourdomain.com          # Email used for git commits by agents

# --- Third-party integrations (optional) ---
VAULT_ORDO_STUDIO_API_KEY=                    # Ordo Studio document generation API key
VAULT_BRAVE_SEARCH_API_KEY=                   # Brave Search API key (legacy, web_search preferred)
